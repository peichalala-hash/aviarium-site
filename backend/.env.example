# API нейросети (OpenAI или совместимый)
OPENAI_API_KEY=sk-...
# Опционально: другой endpoint (например прокси к YandexGPT/GigaChat)
# OPENAI_BASE_URL=https://api.openai.com/v1
# Модель (по умолчанию gpt-4o-mini)
# CHAT_MODEL=gpt-4o-mini

# Порт сервера
PORT=3000

# Telegram для приёма заявок (обратный звонок + заказы)
# Создайте бота через @BotFather, укажите токен и chat_id (личный или группы)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=-1001234567890
